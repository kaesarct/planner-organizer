rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isReviewer() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'reviewer'];
    }
    
    function canManageReports() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'reviewer', 'segretario'];
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isReviewer();
      allow update, delete: if isReviewer() || resource.data.created_by == request.auth.uid;
    }
    
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isReviewer();
      allow update: if isReviewer() || resource.data.assigned_to == request.auth.uid || resource.data.created_by == request.auth.uid;
      allow delete: if isReviewer() || resource.data.created_by == request.auth.uid;
    }
    
    match /permissions/{role} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['segretario', 'reviewer', 'admin'];
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if canManageReports();
      allow delete: if isAdmin();
    }
  }
}
